# ─── Required ────────────────────────────────────────
# Database (Neon pooled for app, unpooled for migrations)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-me-with-openssl-rand-base64-32"

# Set to "true" when the app is deployed behind a reverse proxy (Vercel,
# Cloudflare, Nginx, ...). Enables reading the real client IP from
# x-real-ip / x-forwarded-for so rate limits are enforced per client IP.
# When unset, every request is seen as 127.0.0.1, so pre-auth limits
# (register/sign-in) fall back to per-email keying. Requests reaching the
# server directly (no proxy, no headers) are safe with "true": the trusted
# headers are simply absent and the same per-email fallback applies.
TRUSTED_PROXY="true"

# Encryption key for BYOK API keys (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=""

# ─── Seeding (prisma/seed.ts) ─────────────────────────
# Required for `prisma db seed`; refuses to run in production, and refuses to
# seed a non-loopback database unless NODE_ENV=development is set explicitly.
SEED_ADMIN_EMAIL="admin@appbuilder.local"
SEED_ADMIN_PASSWORD="change-me-please-32-characters-min"

# ─── Agent runtime tuning (all optional) ──────────────
# Cap agent turns per generation. Unset = no cap (runs until the model finishes).
# SOVEREIGN_MAX_ITERATIONS=""
# Cap output tokens per turn. Unset = the provider's own maximum.
# SOVEREIGN_MAX_TOKENS=""
# Consecutive turns without filesystem progress before the run stops (default 12).
# SOVEREIGN_MAX_NO_PROGRESS=""
# Set to "0"/"false" to disable native tool_calls and force the JSON-in-text
# protocol for every provider.
# SOVEREIGN_NATIVE_TOOLS=""
# Vite-in-WebContainer preview is ON by default; set to "0"/"false" to force
# the static file server for every project.
# SOVEREIGN_VITE_PREVIEW=""

# ─── Client (exposed to browser) ────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── OAuth Providers (leave empty to hide from sign-in) ──
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ─── Redis ───────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── Upstash (rate limits, queue) ────────────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudflare R2 (source, artifacts, logs) ─────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# ─── E2B (sandbox runtime) ──────────────────────────
# E2B_API_KEY=""

# ─── Vercel (deployments) ────────────────────────────
# VERCEL_TOKEN=""
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""

# ─── Stripe (billing) ────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_PRO=""
# STRIPE_PRICE_ID_BUSINESS=""

# ─── Email (Resend) ──────────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# ─── WorkOS (SAML SSO) ──────────────────────────────
# WORKOS_API_KEY=""
# WORKOS_CLIENT_ID=""

# ─── GitHub App ──────────────────────────────────────
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""
# GITHUB_APP_WEBHOOK_SECRET=""

# ─── Observability ───────────────────────────────────
# SENTRY_DSN=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# ─── Build ───────────────────────────────────────────
# Set to "true" to skip env validation during `next build`
# SKIP_ENV_VALIDATION="true"
